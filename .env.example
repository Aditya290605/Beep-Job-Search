# Environment configuration
ENV=production
PORT=8080

# Google Cloud Platform
GCP_PROJECT_ID=beep-fresher-jobs
GCP_REGION=asia-south1

# Cloud SQL PostgreSQL Connection
# In Cloud Run, connect via Unix socket:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@/jobs_db?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# Or individually:
DB_USER=postgres
DB_PASSWORD=
DB_NAME=jobs_db
DB_HOST=localhost
DB_PORT=5432
INSTANCE_CONNECTION_NAME=beep-fresher-jobs:asia-south1:fresher-jobs-db

# Vertex AI / Gemini LLM Settings
# For local LLM verification without GCP SDK, paste a free Google AI Studio key in GEMINI_API_KEY
# or paste `gcloud auth print-access-token` in VERTEX_ACCESS_TOKEN:
GEMINI_API_KEY=
VERTEX_ACCESS_TOKEN=
VERTEX_AI_REGION=us-central1
VERTEX_AI_MODEL=gemini-3.5-flash-lite
